    Properties:
      Name: /lab/credentials/access-key-id
      Type: String
      Value: !Ref LabUserAccessKey
      Description: Lab User Access Key ID (for Lab 4 local Strands Agent)

  SecretAccessKeyParam:
    Type: AWS::SSM::Parameter
    Properties:
      Name: /lab/credentials/secret-access-key
      Type: String
      Value: !GetAtt LabUserAccessKey.SecretAccessKey
      Description: Lab User Secret Access Key (for Lab 4 local Strands Agent)

