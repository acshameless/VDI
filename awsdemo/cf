  # ============================================================
  # IAM - EC2 Role
  # ============================================================
  WorkshopEC2Role:
    Type: AWS::IAM::Role
    Properties:
      RoleName: workshop-ec2-role
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore
      Policies:
        - PolicyName: WorkshopEC2Policy
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              # S3 Access (data + assets + codebuild sources)
              - Effect: Allow
                Action:
                  - s3:Get*
                  - s3:List*
                Resource:
                  - !GetAtt WorkshopDataBucket.Arn
                  - !Sub "${WorkshopDataBucket.Arn}/*"
                  - !GetAtt AthenaResultsBucket.Arn
                  - !Sub "${AthenaResultsBucket.Arn}/*"
                  - !Sub "arn:aws:s3:::${CloudLabAssetBucket}"
                  - !Sub "arn:aws:s3:::${CloudLabAssetBucket}/*"
                  - "arn:aws:s3:::bedrock-agentcore-codebuild-sources-*"
                  - "arn:aws:s3:::bedrock-agentcore-codebuild-sources-*/*"
              - Effect: Allow
                Action:
                  - s3:PutObject
                Resource:
                  - !Sub "${WorkshopDataBucket.Arn}/*"
                  - !Sub "${AthenaResultsBucket.Arn}/*"
                  - "arn:aws:s3:::bedrock-agentcore-codebuild-sources-*/*"
              - Effect: Allow
                Action:
                  - s3:CreateBucket
                  - s3:PutBucketLifecycle
                  - s3:PutLifecycleConfiguration
                  - s3:PutBucketPolicy
                  - s3:GetBucketLocation
                Resource:
                  - "arn:aws:s3:::bedrock-agentcore-codebuild-sources-*"
              # Athena Access
              - Effect: Allow
                Action:
                  - athena:Get*
                  - athena:List*
                  - athena:StartQueryExecution
                Resource: "*"
              # Glue Catalog Access
              - Effect: Allow
                Action:
                  - glue:Get*
                  - glue:List*
                  - glue:BatchGet*
                Resource: "*"
              # Bedrock Access
              - Effect: Allow
                Action:
                  - bedrock:InvokeModel
                Resource:
                  - "arn:aws:bedrock:*::foundation-model/amazon.nova-*"
              # S3 Vectors Access
              - Effect: Allow
                Action:
                  - s3vectors:Get*
                  - s3vectors:List*
                  - s3vectors:QueryVectors
                Resource: "*"
              # ECR Access (Lab 2 + cleanup)
              - Effect: Allow
                Action:
                  - ecr:*
                Resource: "*"
              # AgentCore Access (Lab 2 deploy)
              - Effect: Allow
                Action:
                  - bedrock-agentcore:*
                Resource: "*"
              # Cognito (Lab 2 deploy + cleanup)
              - Effect: Allow
                Action:
                  - cognito-idp:*
                Resource: "*"
              # IAM for Gateway & AgentCore SDK roles (Lab 2 + cleanup)
              - Effect: Allow
                Action:
                  - iam:Get*
                  - iam:List*
                Resource: "*"
              - Effect: Allow
                Action:
                  - iam:CreateRole
                  - iam:DeleteRole
                  - iam:PutRolePolicy
                  - iam:DeleteRolePolicy
                  - iam:AttachRolePolicy
                  - iam:DetachRolePolicy
                  - iam:PassRole
                  - iam:CreateServiceLinkedRole
                Resource:
                  - !Sub "arn:aws:iam::${AWS::AccountId}:role/Workshop*"
                  - !Sub "arn:aws:iam::${AWS::AccountId}:role/workshop*"
                  - !Sub "arn:aws:iam::${AWS::AccountId}:role/agentcore*"
                  - !Sub "arn:aws:iam::${AWS::AccountId}:role/AmazonBedrockAgentCore*"
                  - "arn:aws:iam::*:role/aws-service-role/*"
              # CodeBuild (AgentCore SDK builds)
              - Effect: Allow
                Action:
                  - codebuild:BatchGet*
                  - codebuild:List*
                  - codebuild:CreateProject
                  - codebuild:UpdateProject
                  - codebuild:StartBuild
                Resource:
                  - !Sub "arn:aws:codebuild:*:${AWS::AccountId}:project/bedrock-agentcore-*"
              # CloudWatch Logs
              - Effect: Allow
                Action:
                  - logs:Describe*
                  - logs:Get*
                  - logs:List*
                  - logs:FilterLogEvents
                  - logs:CreateLogGroup
                  - logs:CreateLogStream
                  - logs:PutLogEvents
                  - logs:PutRetentionPolicy
                  - logs:PutResourcePolicy
                  - logs:PutDeliverySource
                  - logs:PutDeliveryDestination
                  - logs:CreateDelivery
                Resource: "*"
              # SSM
              - Effect: Allow
                Action:
                  - ssm:Get*
                  - ssm:Describe*
                  - ssm:List*
                Resource: "*"
              # Secrets Manager (AgentCore OAuth2)
              - Effect: Allow
                Action:
                  - secretsmanager:CreateSecret
                  - secretsmanager:DeleteSecret
                  - secretsmanager:GetSecretValue
                  - secretsmanager:ListSecrets
                  - secretsmanager:DescribeSecret
                Resource: "*"
              # KMS
              - Effect: Allow
                Action:
                  - kms:Decrypt
                  - kms:GenerateDataKey
                Resource: "*"
              # STS
              - Effect: Allow
                Action:
                  - sts:Get*
                Resource: "*"
              # X-Ray
              - Effect: Allow
                Action:
                  - xray:Get*
                  - xray:List*
                  - xray:PutResourcePolicy
                  - xray:UpdateTraceSegmentDestination
                Resource: "*"
              # Application Signals
              - Effect: Allow
                Action:
                  - application-signals:StartDiscovery
                Resource: "*"

  EC2InstanceProfile:
    Type: AWS::IAM::InstanceProfile
    Properties:
      InstanceProfileName: workshop-ec2-profile
      Roles:
        - !Ref WorkshopEC2Role

  # ============================================================
  # EC2 Dev Instance (Lab 2 & Lab 4 operations)
  # ============================================================
  WorkshopSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Workshop dev instance - SSH + Streamlit + MCP
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 8501
          ToPort: 8501
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 8000
          ToPort: 8001
          CidrIp: 0.0.0.0/0

  WorkshopEC2Instance:
    Type: AWS::EC2::Instance
    DependsOn:
      - EC2InstanceProfile
      - DataCopyCustomResource
    Properties:
      ImageId: !Ref LatestAmiId
      InstanceType: m5.xlarge
      IamInstanceProfile: !Ref EC2InstanceProfile
      SecurityGroupIds:
        - !GetAtt WorkshopSecurityGroup.GroupId
      Tags:
        - Key: Name
          Value: workshop-dev
      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash
          set -ex

          # System updates
          dnf update -y
          dnf install -y python3.11 python3.11-pip git unzip

          # Install pip for python3.11
          python3.11 -m ensurepip --upgrade 2>/dev/null || true

          # Create workshop directory
          WORKSHOP_DIR=/home/ec2-user/workshop
          mkdir -p $WORKSHOP_DIR
          cd $WORKSHOP_DIR

          # Download and unzip MCP servers from Assets bucket
          aws s3 cp s3://${CloudLabAssetBucket}/${CloudLabAssetPrefix}/assets/mcp-servers/athena-mcp.zip /tmp/athena-mcp.zip
          aws s3 cp s3://${CloudLabAssetBucket}/${CloudLabAssetPrefix}/assets/mcp-servers/s3vectors-mcp.zip /tmp/s3vectors-mcp.zip
          aws s3 cp s3://${CloudLabAssetBucket}/${CloudLabAssetPrefix}/assets/deploy/deploy.zip /tmp/deploy.zip

          # Extract MCP servers
          mkdir -p $WORKSHOP_DIR/mcp-servers/athena-mcp
          mkdir -p $WORKSHOP_DIR/mcp-servers/s3vectors-mcp
          mkdir -p $WORKSHOP_DIR/deploy

          unzip -o /tmp/athena-mcp.zip -d $WORKSHOP_DIR/mcp-servers/athena-mcp/
          unzip -o /tmp/s3vectors-mcp.zip -d $WORKSHOP_DIR/mcp-servers/s3vectors-mcp/
          unzip -o /tmp/deploy.zip -d $WORKSHOP_DIR/deploy/

          # Configure .env files for MCP servers
          cat > $WORKSHOP_DIR/mcp-servers/athena-mcp/.env << 'ENVEOF'
          DEFAULT_S3_OUTPUT_LOCATION=s3://${WorkshopDataBucket}/athena-results/
          WORKGROUP=workshop-workgroup
          AWS_REGION=${AWS::Region}
          ENVEOF

          cat > $WORKSHOP_DIR/mcp-servers/s3vectors-mcp/.env << 'ENVEOF'
          VECTOR_BUCKET_NAME=workshop-vectors-${AWS::AccountId}
          INDEX_NAME=knowledge-base-index
          AWS_REGION=${AWS::Region}
          ENVEOF

          # Install Python dependencies
          su - ec2-user -c "python3.11 -m pip install --user boto3 'mcp[cli]' bedrock-agentcore-starter-toolkit"

          # Install dependencies for each MCP server
          su - ec2-user -c "cd $WORKSHOP_DIR/mcp-servers/athena-mcp && python3.11 -m pip install --user -r requirements.txt"
          su - ec2-user -c "cd $WORKSHOP_DIR/mcp-servers/s3vectors-mcp && python3.11 -m pip install --user -r requirements.txt"

          # Set ownership
          chown -R ec2-user:ec2-user $WORKSHOP_DIR

          # Export AWS_REGION for ec2-user shell (deploy.py reads from env)
          echo 'export AWS_REGION=${AWS::Region}' >> /home/ec2-user/.bashrc
          echo 'export AWS_DEFAULT_REGION=${AWS::Region}' >> /home/ec2-user/.bashrc

          # Signal completion
          echo "Workshop environment setup complete!" > $WORKSHOP_DIR/.setup-complete
          echo "Setup completed at $(date)" >> $WORKSHOP_DIR/.setup-complete

  # ============================================================
  # IAM User + Access Key for Lab 4 (local Strands Agent)
  # Participants retrieve AK/SK from SSM Parameter Store
  # ============================================================
  LabUser:
    Type: AWS::IAM::User
    Properties:
      UserName: lab-user
      Policies:
        - PolicyName: LabUserPolicy
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - bedrock:InvokeModel
                  - bedrock:InvokeModelWithResponseStream
                Resource:
                  - "arn:aws:bedrock:*::foundation-model/amazon.nova-*"
                  - !Sub "arn:aws:bedrock:*:${AWS::AccountId}:inference-profile/us.amazon.nova-*"
                  - !Sub "arn:aws:bedrock:*:${AWS::AccountId}:inference-profile/eu.amazon.nova-*"

  LabUserAccessKey:
    Type: AWS::IAM::AccessKey
    Properties:
      UserName: !Ref LabUser

  AccessKeyIdParam:
